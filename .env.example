# Copy to .env for local overrides. Every value below is optional -
# the defaults in backend/config.py already work out of the box.

# Database (SQLite by default; any SQLAlchemy async URL works)
DATABASE_URL=sqlite+aiosqlite:///./finance_agent.db

# App
APP_ENV=development
DEBUG=true
FRONTEND_URL=http://localhost:5173

# Business rules (rupees / ratios)
APPROVAL_THRESHOLD=1000000
PO_VARIANCE_TOLERANCE=0.02
GST_RATE=0.18
DUPLICATE_CONFIDENCE_THRESHOLD=0.85
